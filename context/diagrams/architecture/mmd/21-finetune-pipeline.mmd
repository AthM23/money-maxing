  FT_TR_OPENAI -. "reason" .-> FT_TR_BASE
  FT_SP_LEAK -- "clean train set" --> FT_TR_BASE
  FT_SP_LEAK -- "same rows, pair features" --> FT_TR_GBT
  FT_TR_BASE --> FT_TR_NOGPU
  FT_TR_NOGPU --> FT_TR_TOGETHER
  FT_TR_NOGPU --> FT_TR_FIREWORKS
  FT_TR_NOGPU --> FT_TR_MODAL
  FT_TR_TOGETHER --> FT_TR_HP
  FT_TR_FIREWORKS --> FT_TR_HP
  FT_TR_MODAL --> FT_TR_HP
  FT_TR_HP --> FT_TR_ART
  FT_TR_GBT --> FT_TR_ART
  FT_DS_PAIRS -. "later" .-> FT_TR_DPO
  FT_TR_DPO -. "new adapter version" .-> FT_TR_ART

  FT_TR_ART -- "fine-tuned + GBT" --> FT_EV_RANK
  FT_TR_ART --> FT_EV_F1
  FT_TR_ART --> FT_EV_JSON
  FT_SP_TEST -- "July rows" --> FT_EV_RANK
  FT_EV_BASE0 --> FT_EV_PREC
  FT_EV_BASEM --> FT_EV_PREC
  FT_EV_BASEC --> FT_EV_COST
  FT_EV_RANK --> FT_EV_PREC
  FT_EV_F1 --> FT_EV_PREC
  FT_EV_JSON --> FT_EV_PREC
  FT_EV_PREC --> FT_EV_HELD
  FT_EV_COST --> FT_EV_HELD
  FT_EV_HELD --> FT_EV_GATE
  FT_EV_HELD -. "same held-out sets" .-> FT_TO_BENCH

  FT_EV_GATE -- "yes" --> FT_CAL_CONF
  FT_EV_GATE -. "no: tier 1 stays claude-haiku-4-5 (or GBT head)" .-> FT_TO_ROUTER
  FT_SP_CAL -- "June rows" --> FT_CAL_FIT
  FT_CAL_CONF --> FT_CAL_FIT --> FT_CAL_THR --> FT_REG
  FT_CAL_DEC -- "no" --> FT_CAL_ABSTAIN
  FT_CAL_DEC -- "yes" --> FT_INV

  FT_REG -- "status = shadow" --> FT_SH_RUN
  FT_SH_RUN --> FT_SH_LOG --> FT_PR_GATE
  FT_PR_GATE -- "fail: stay in shadow" --> FT_SH_RUN
  FT_PR_GATE -- "pass" --> FT_PR_HUMAN
  FT_PR_HUMAN -- "status = promoted" --> FT_SRV_ENDPOINT
  FT_PR_HUMAN --> FT_SRV_LOCAL
  FT_PR_HUMAN -- "head won by GBT" --> FT_SRV_GBT
  FT_SRV_ENDPOINT --> FT_CAL_DEC
  FT_SRV_LOCAL --> FT_CAL_DEC
  FT_SRV_GBT --> FT_CAL_DEC
  FT_INV -- "reject" --> FT_KREJ
  FT_INV -- "accept: tier 1 served it" --> FT_TO_ROUTER
  FT_CAL_ABSTAIN -. "next tier" .-> FT_TO_ROUTER
  FT_KREJ -. "next tier" .-> FT_TO_ROUTER

  FT_KREJ -.-> FT_MON_KREJ
  FT_SH_LOG -.-> FT_MON_CONF
  FT_SH_LOG -.-> FT_MON_NEW
  FT_FROM_LEARNING -. "tier 0 fire counts" .-> FT_MON_ZERO
