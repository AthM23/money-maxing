  FT_MON_DEMOTE -. "status = shadow" .-> FT_REG
  FT_MON_RETRAIN -. "rebuild dataset" .-> FT_DS_EXPORT

  FT_SH_LOG -.-> FT_SC_AGREE
  FT_MON_KREJ -.-> FT_SC_SHARE
  FT_EV_COST -.-> FT_SC_COST

