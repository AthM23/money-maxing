flowchart TB

  subgraph TB_SG10["10 · Test data provenance (built first, read by every layer below)"]
    TB_SEED[/"world seed (integer)<br/>pnpm seed --target=all --reset"/]
    TB_WORLD[("world/northwind.json<br/>canonical world file: Q2 history + July + planted<br/>drift · manifest maps world id → external fn: id")]
    TB_CASES[/"tests/cases.csv: id, expected_route,<br/>route_qualifier, tier, pack,<br/>min_fixture, in_spec_scope, status"/]
    TB_FIXTURES["per-case fixtures tests/fixtures/CASE_ID/<br/>world patch + source files<br/>learnable cases: before and after variants"]
    TB_KEY[("planted-drift answer key + corpus labels<br/>OUTSIDE every agent tool root,<br/>outside memory.* and the learning loop")]
    TB_HELDOUT[("held-out manifest: entity ids and case ids<br/>split by time and by whole vendor / customer<br/>cases: 25-30% stratified by route (sheet 20)")]
    TB_ACL{{"isolation check (code): no tool path, fact,<br/>policy or trace contains answer-key content<br/>fails the run if violated"}}
    TB_SCORER["scorer (pure code, no model)<br/>reads answer key + ledger + route log<br/>read-only to the research loop"]
    TB_TO_LEARNING["to learning loops (diagram 20)"]
  end

  subgraph TB_SG1["1 · Unit and property tests (vitest, no model, seconds)"]
    TB_U_F["kernel F fixtures, pass and fail each:<br/>debits equal credits · subledger equals GL control<br/>bank line matched exactly once · forecast opening cash"]
    TB_U_E["kernel E fixtures, pass and fail each:<br/>trace_id exists · quote is substring of trace<br/>party, amount, date tie · three-way within tolerance"]
    TB_U_P["kernel P fixtures, pass and fail each:<br/>preparer not approver (G-02) · approval at $500<br/>approval matrix · period open (G-03) · accrual reverses"]
    TB_U_J["kernel J fixtures, pass and fail each:<br/>policy approved and condition matches<br/>fact active on date and in scope · authority ceiling (G-04)"]
    TB_U_MONEY["money invariants F-07: integer cents only<br/>property test: no float on any amount path<br/>0.1 + 0.2 style cases tie exactly"]
    TB_U_F08["F-08 minor-unit exponent (JPY 0, KWD 3)<br/>OUT OF SCOPE: FX excluded by spec<br/>listed so it is not read as a regression"]
    TB_U_SCHED["schedule engine property test (random terms):<br/>sum of periods equals contract or prepaid value<br/>concession and mid-month upsell revisions still sum"]
    TB_U_SUBSET["subset-sum bounds (A-05): search limited by<br/>counterparty + date window, candidate cap,<br/>time budget → abstain, never partial answer"]
    TB_U_INGEST["ingestion refusals with stated reason:<br/>F-01 field count vs header · F-02 ambiguous date<br/>F-04 sign vs control total · F-12 malformed export"]
    TB_U_IDEM["idempotent re-ingest F-05:<br/>same source_system + source_id twice<br/>→ row counts unchanged"]
    TB_U_MODELIO["model output guards: F-09 fact dated outside<br/>open fiscal window → reject<br/>F-10 finish_reason length or empty content → raise"]
    TB_U_MUT["mutation test: edit a quoted span in a trace<br/>→ kernel E rejects the workpaper<br/>(also demo beat 5)"]
    TB_U_GATE{{"unit gate: every kernel check has<br/>at least one pass and one fail fixture<br/>all green, else stop"}}
  end

  subgraph TB_SG2["2 · Component benchmarks (one deterministic engine or model head at a time)"]
    TB_C_MATCH["matching engine: precision and recall on<br/>seeded bank lines with decoys<br/>A-03 net fee · A-05 many-to-one · A-12 transposed ref"]
    TB_C_ER["entity resolution on mutated descriptors:<br/>A-09, A-10, F-13, H-3 (GUSTO PAYROLL →<br/>GUSTO TAX COLLECTION): top-1 on stable key"]
    TB_C_EXTRACT["extraction head (claude-haiku-4-5):<br/>field-level accuracy vs world-file ground truth<br/>contract terms · bill header and lines · remittance"]
    TB_C_NORM["deterministic answer normaliser:<br/>amounts exact in integer cents · ISO dates<br/>normalised strings (scoring idea from DABstep)"]
    TB_C_COMP["drift comparators: every planted drift detected<br/>8 live plants + 3 second-wave plants<br/>exception recall TARGET 100% · known fact suppresses<br/>expected diff: false intents to be measured"]
    TB_C_FORECAST["forecast engine: opening cash equals GL cash<br/>miss explanation ties to bank actuals<br/>(customer pays two weeks late)"]
    TB_C_CALIB["router heads and confidence (G-11):<br/>per-tier agreement and abstain rate<br/>checklist score vs observed accuracy: to be measured"]
    TB_C_REPORT["component table: metric, n, interval<br/>every cell: to be measured"]
  end

  subgraph TB_SG3["3 · Function-pack scenario tests (115-case corpus, score the route not the match)"]
    TB_S_LOAD["harness loads cases.csv<br/>19 cases in_spec_scope = no reported separately<br/>A-07 / H-2 processor payout: undecided"]
    TB_S_MIN["stage A: 22 min-fixture case ids first<br/>every route + all six demo beats"]
