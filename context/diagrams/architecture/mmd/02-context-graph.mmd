  CG_U_WHO -- "beats" --> CG_V_NET30
  CG_U_WHO -- "beats" --> CG_V_UPLIFT
  CG_U_WHO -- "beats" --> CG_V_USAGE
  CG_V_PREPAY --> CG_V_WHO
  CG_V_NET30 --> CG_V_WHO
  CG_V_UPLIFT --> CG_V_WHO
  CG_V_USAGE --> CG_V_WHO
