  classDef stretch fill:#fafafa,stroke:#999999,stroke-dasharray:6 4,color:#444444

  class H_NEXT src
  class H_NOT_BLOCKED,H_HANDOFF,H_REUSE,H_WHO_OWNER,H_WHO_FALLBACK,H_ASKED,H_Q_WHAT,H_Q_CHECKED,H_Q_UNKNOWN,H_Q_OPTIONS,H_Q_DEFAULT,H_Q_DEADLINE,H_WAIT,H_CHK_BLOCK,H_IDENT_FAIL,H_ANS_ROW,H_RESUME,H_TIMEOUT,H_BACKTEST,H_DRIFT,H_ROUTER,H_BILLING,H_REVFC,H_PROPOSE,H_NOSCOPE,H_EXPIRE,H_EVID_VER code
  class H_SEARCH,H_Q_COMPOSE,H_PARSE,H_COMPILE model
  class H_HUMAN,H_FACT_APPROVER,H_PR human
  class H_INTENT,H_ESC_TBL,H_VERBATIM,H_FACT_TBL,H_POLICY_TBL,H_SCORE store
  class H_FOUND,H_G_EXHAUST,H_G_MEM,H_G_BUS,H_G_DEDUPE,H_WHO_MATRIX,H_G_TUNNEL,H_G_SIG,H_G_IDENT,H_G_CONF,H_G_CLAMP,H_G_STABLE,H_G_END,H_G_AUTH,H_G_TWO,H_G_BT,H_G_SCOPE,H_KERNEL,H_ZERO_FIRE gate
  class H_EX_INITECH,H_EX_WAYNE,H_EX_H4,H_FACT_CAND,H_FACT_REJECT,H_FACT_LIFE,H_CORR,H_TIER,H_CONTRA,H_ZERO_ACT,H_REFUSE_GEN,H_M_Q,H_M_REPEAT,H_M_FACTS,H_M_REFUSALS,H_M_BLOCKED learn
  class H_SL_BTN,H_SL_THREAD,H_READBACK ext
  class H_AUTO rAuto
  class H_R_PROPOSE rPropose
  class H_ESCALATE rEscalate
  class H_REFUSE_LEARN rRefuse
  class H_BLOCK_POLICY rBlock
