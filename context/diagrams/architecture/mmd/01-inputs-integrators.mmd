flowchart TB

  subgraph IN_SG1["1 · The seeded world (test harness side, not product code)"]
    IN_WORLD[/"world/northwind.json · generated from an integer seed<br/>ONE canonical world file: Northwind Systems, $60M<br/>SaaS, 12 customers, 10 vendors, Apr-Jun + July 2026<br/>every system tells the same story except planted drift"/]
    IN_PLANT["planted drift written into the world file<br/>Initech $144k deal vs $129.6k invoices · Wayne<br/>$3,300 short · refund posted twice · $12.40 diff<br/>changed vendor bank details · departed employee"]
    IN_ANSKEY[("planted-drift ANSWER KEY<br/>stored OUTSIDE anything an agent can read<br/>no tool, no table, no working-dir path reaches it")]
    IN_SEEDCMD["pnpm seed --target=system or all --reset<br/>restores a clean state per target"]
    IN_SEEDER["seeder per target (code), idempotent<br/>every record carries an fn: external id<br/>re-run = upsert on fn: id, never a duplicate<br/>verifies each write by id, not search (HubSpot lag)"]
    IN_MANIFEST[("seed manifest<br/>world id → external id per target system<br/>+ world recorded_time per record")]
    IN_CLOCKGAP["brief finding: THREE CLOCKS<br/>Q2 is seeded today, so QBO CreateTime, HubSpot<br/>createdate, Increase created_at all say 19 Sep 2026<br/>→ naive recorded_time makes replay return nothing"]
  end

