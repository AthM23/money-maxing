{
  "name": "footnote",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Footnote: an agent finance team that closes a month on one ledger and one judgment layer.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "tsx src/contract/init-db.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
