{
  "name": "footnote",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "eval": "tsx eval/run.ts",
    "demo": "tsx src/demo/run.ts",
    "inbox": "tsx src/demo/inbox.ts",
    "seed": "tsx --env-file-if-exists=.env src/seed/cli.ts",
    "skeleton": "tsx --env-file-if-exists=.env src/skeleton/run.ts",
    "console": "tsx --env-file-if-exists=.env console/server.ts",
    "ingest": "tsx --env-file-if-exists=.env src/ingest/cli.ts",
    "auditpack": "tsx src/audit/cli.ts",
    "worker": "tsx src/worker/cli.ts",
    "learn": "tsx src/learn/cli.ts",
    "rerun": "tsx src/learn/rerunCli.ts",
    "demo:seed": "tsx src/demo/seedCli.ts",
    "spine": "tsx --env-file-if-exists=.env src/spine/run.ts",
    "mirror": "tsx --env-file-if-exists=.env src/mirror/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.277",
    "@anthropic-ai/sdk": "^0.127.0",
    "@slack/socket-mode": "^3.0.1",
    "@slack/web-api": "^8.1.1",
    "better-sqlite3": "^12.2.0",
    "openai": "^7.19.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
