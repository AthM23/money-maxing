# Person A. Only ANTHROPIC_API_KEY is required: the controller falls back to a Claude model and the terminal inbox replaces Slack.
ANTHROPIC_API_KEY=
# Optional: a different model family for the controller agent
OPENAI_API_KEY=
FOOTNOTE_CONTROLLER_MODEL=
# Optional: Slack app in Socket Mode (bot scopes chat:write, im:write; app token with connections:write)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Person B
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_REFRESH_TOKEN=
