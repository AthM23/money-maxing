# Person A. Only ANTHROPIC_API_KEY is required: the controller falls back to a Claude model and the terminal inbox replaces Slack.
ANTHROPIC_API_KEY=
# Optional: a different model family for the controller agent
OPENAI_API_KEY=
FOOTNOTE_CONTROLLER_MODEL=
# Optional: Slack app in Socket Mode (bot scopes chat:write, im:write; app token with connections:write)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Person B
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_REFRESH_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
HUBSPOT_ACCESS_TOKEN=
# optional, Person B: database path, and live sources for the skeleton (gmail,slack)
FOOTNOTE_DB=data/footnote.db
# Which world the seeder loads (northwind | global-july) and where its local stores go. One database holds one world:
# for the global July use FOOTNOTE_WORLD=global-july, FOOTNOTE_DB=data/global-july.db, FOOTNOTE_STORES=data/stores-global-july
FOOTNOTE_WORLD=
FOOTNOTE_STORES=
FOOTNOTE_LIVE=
# who plays the world's people in the real workspace (src/seed/slackUsers.ts)
SLACK_USER_MAP=
SLACK_DEFAULT_USER=
